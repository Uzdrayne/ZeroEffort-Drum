{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-vs2019",
      "displayName": "Windows x64 / Visual Studio 2019",
      "generator": "Visual Studio 16 2019",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "BUILD_TESTING": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "windows-vs2019", "configuration": "Release" },
    { "name": "debug", "configurePreset": "windows-vs2019", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "windows-vs2019", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "windows-vs2019", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}